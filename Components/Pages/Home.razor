@page "/"

<PageTitle>Prueba técnica Ziur</PageTitle>

<section class="hero">
    <div class="hero-card text-center text-white">
        <span class="badge rounded-pill hero-pill mb-3">Prueba técnica</span>

        <h1 class="display-5 fw-bold mb-1">Prueba técnica Ziur</h1>
        <h2 class="h3 fw-light mb-4">Harold Castaño</h2>

        <p class="lead mb-4">
            Desarrollada en Blazor, con arquitectura hexagonal
        </p>

        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            <span class="tech-chip"><i class="bi bi-code-slash me-1"></i>Blazor</span>
            <span class="tech-chip"><i class="bi bi-hexagon me-1"></i>Arquitectura hexagonal</span>
            <span class="tech-chip"><i class="bi bi-bootstrap me-1"></i>Bootstrap 5</span>
        </div>

        <a href="movimientos" class="btn btn-light btn-lg rounded-pill px-4 fw-semibold">
            Ver movimientos <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</section>
